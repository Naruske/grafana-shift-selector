{
  "$schema": "https://json.schemastore.org/swcrc",
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "tsx": true,
      "decorators": false,
      "dynamicImport": true
    },
    "baseUrl": "./src",
    "paths": {
      "*": [
        "node_modules",
        "src/*"
      ]
    }
  }
}
